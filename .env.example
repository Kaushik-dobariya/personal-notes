# Application Configuration
APP_NAME="Personal Notes"
ENVIRONMENT="development"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Security & Sessions
# Generate a secure key in production with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change-this-to-a-super-secret-cryptographic-key"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
COOKIE_NAME="personal_notes_session"
COOKIE_SECURE=False  # Set to True in production (HTTPS)
COOKIE_SAMESITE="lax"

# Database Configuration
# PostgreSQL (Default):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/personal_notes"
# Cloud PostgreSQL (Neon / Supabase example):
# DATABASE_URL="postgresql+asyncpg://user:password@ep-something.aws.neon.tech/neondb"
# SQLite Async fallback (for instant local testing without local PostgreSQL):
# DATABASE_URL="sqlite+aiosqlite:///./personal_notes.db"

# Password Reset
PASSWORD_RESET_EXPIRE_MINUTES=30
